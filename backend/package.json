{
  "name": "bicileal-node-backend",
  "version": "1.0.0",
  "description": "Backend alternativo en Node para la app Bicileal",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run db:generate",
    "postinstall": "npm run db:generate",
    "db:generate": "prisma generate && prisma generate --schema prisma/schema.production.prisma",
    "db:push": "prisma db push",
    "db:push:production": "prisma db push --schema prisma/schema.production.prisma",
    "db:studio": "prisma studio",
    "db:seed": "node src/data/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.19.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.1"
  }
}
