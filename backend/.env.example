# Local SQLite development is configured in prisma/schema.prisma.
# Generate a new long random value before setting it in Vercel.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated exact browser origins; no trailing slash.
CORS_ORIGINS=http://localhost:5173

# Required in Vercel to persist product images outside the function filesystem.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase PostgreSQL: transaction pooler for DATABASE_URL, session pooler for DIRECT_URL.
# Production automatically adds pgbouncer=true to DATABASE_URL for Prisma.
DATABASE_URL=
DIRECT_URL=
